---
import { site } from '../lib/content';
import forestMark from '../assets/branding/header-logo.png';
import ivoryMark from '../assets/branding/mark-ivory.webp';
interface Props { variant?: 'forest' | 'ivory'; }
const { variant = 'forest' } = Astro.props;
const mark = variant === 'ivory' ? ivoryMark : forestMark;
---
<span class:list={['brand', `brand-${variant}`]}><img class="brand-mark" src={mark.src} width={mark.width} height={mark.height} alt="CH 2027 monogram" decoding="async" /><span>{site.brand}</span></span>
