---
import {activities} from '../lib/content';
import SectionHeading from './SectionHeading.astro';
---
<section id="skiing" class="section wrap" aria-labelledby="skiing-heading">
<SectionHeading number="03" label="Skiing & activities" heading={activities.heading} intro={activities.intro} id="skiing-heading" />
<div class="activities-grid">{activities.items.map((item,index)=><article class="activity-card"><div class="card-top"><span class="card-number" aria-hidden="true">0{index+1}</span><span class="tag">{item.tag}</span></div><h3>{item.title}</h3><p>{item.description}</p>{item.link && <a class="text-link" href={item.link.url}>{item.link.label} <span aria-hidden="true">↗</span></a>}</article>)}</div>
</section>
