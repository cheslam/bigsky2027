---
import {travel} from '../lib/content';
import SectionHeading from './SectionHeading.astro';
---
<section id="travel" class="travel-section" aria-labelledby="travel-heading"><div class="wrap section">
<SectionHeading number="02" label="Travel" heading={travel.heading} intro={travel.intro} id="travel-heading" />
<div class="travel-grid">{travel.items.map((item,index)=><article class:list={['travel-card',{'airport-card':index===0}]}><p class="eyebrow">{item.eyebrow}</p><h3>{item.title}</h3><p>{item.description}</p>{item.link && <a class="text-link" href={item.link.url}>{item.link.label} <span aria-hidden="true">↗</span></a>}</article>)}</div>
</div></section>
