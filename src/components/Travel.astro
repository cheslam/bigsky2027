---
import { publicUrl } from '../lib/urls';
import {travel} from '../lib/content';
import SectionHeading from './SectionHeading.astro';
---
<section id="travel" class="travel-section" aria-labelledby="travel-heading"><div class="wrap section">
<SectionHeading number="02" label="Travel" heading={travel.heading} intro={travel.intro} id="travel-heading" />
<div class="travel-grid">{travel.items.map((item,index)=><article class:list={['travel-card',{'airport-card':index===0,'flight-card':!!item.flights}]}><p class="eyebrow">{item.eyebrow}</p><h3>{item.title}</h3>
{item.flights && <div class="flight-list">{item.flights.map(flight=><div class="flight-leg"><p class="flight-label">{flight.label} <span>{flight.date}</span></p><div class="flight-route"><div><strong>{flight.from}</strong><span>{flight.departure}</span></div><span class="flight-arrow" aria-label="to">→</span><div><strong>{flight.to}</strong><span>{flight.arrival}</span></div></div></div>)}</div>}
<p>{item.description}</p>{item.link && <a class="text-link" href={publicUrl(item.link.url)}>{item.link.label} <span aria-hidden="true">↗</span></a>}</article>)}</div>
</div></section>
